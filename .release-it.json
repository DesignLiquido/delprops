{
    "git": {
        "commitMessage": "Lançamento da versão v${version}"
    },
    "github": {
        "release": true
    },
    "npm": {
        "publishPath": "./dist"
    },
    "hooks": {
        "before:init": ["yarn empacotar"],
        "after:bump": [
            "yarn copyfiles -V ./package.json ./dist",
            "yarn copyfiles -V ./README.md ./dist",
            "yarn copyfiles \"./bin/**\" ./dist",
            "node ./scripts/ajustar-pacote-dist.js"
        ]
    }
}
