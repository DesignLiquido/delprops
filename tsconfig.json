{
    "compilerOptions": {
        "outDir": "dist",
        "module": "commonjs",
        "target": "ES2020",
        "rootDir": "fontes",
        "allowJs": true,
        "sourceMap": true,
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "exclude": [
        "coverage",
        "dist/**/*",
        "node_modules",
        "jest.config.ts",
        "testes/**/*"
    ]
}
